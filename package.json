{
  "name": "agent-web",
  "version": "0.1.0",
  "description": "Web CLI for AI agents: fetch pages as markdown, search via SearXNG, map sites. Local network and proxy aware.",
  "type": "module",
  "bin": {
    "web": "src/cli.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bash scripts/build.sh",
    "build:all": "bash scripts/build.sh all",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/turndown": "^5.0.5",
    "typescript": "^5.6.0"
  }
}
